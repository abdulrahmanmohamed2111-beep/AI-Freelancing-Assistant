# Copy to secrets.toml locally, or paste these settings into Streamlit Cloud Secrets.
# Never commit real keys. Use an installed model name, or your provider's model ID.
LLM_PROVIDER = "compatible_api"
LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "openai/gpt-oss-20b"
LLM_API_KEY = ""
